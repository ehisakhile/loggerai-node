{
  "name": "@loggerai/node",
  "version": "0.1.0",
  "description": "LoggerAI for Node.js: performance monitoring, errors, logs, health checks and server metrics for Express, Fastify, NestJS and Next.js.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "loggerai": "bin/loggerai.js"
  },
  "files": ["src", "bin", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": ["monitoring", "apm", "observability", "express", "fastify", "nextjs", "nestjs", "errors", "logging"],
  "homepage": "https://loggerai.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehisakhile/loggerai-node.git"
  },
  "author": "LoggerAI <dev@loggerai.uk>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "express": "^5.1.0",
    "fastify": "^5.4.0"
  }
}
